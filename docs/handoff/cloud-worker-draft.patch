+def test_runtime_report_has_only_allowlisted_context(tmp_path, config, monkeypatch, published):
+    context = {
+        "CLOUD_RUN_JOB": "flowstate-smoke",
+        "CLOUD_RUN_EXECUTION": "flowstate-smoke-abcde",
+        "CLOUD_RUN_TASK_INDEX": "0",
+        "CLOUD_RUN_TASK_ATTEMPT": "0",
+    }
+    for name, value in {
+        **context,
+        "CLOUD_RUN_TASK_COUNT": "1",
+        "FLOWSTATE_BUILD_COMMIT": "abcdef0123" * 4,
+        "GOOGLE_APPLICATION_CREDENTIALS": "do-not-record-credentials.json",
+        "FLOWSTATE_PRIVATE_TOKEN": "do-not-record-private-token",
+        "CLOUD_RUN_PRIVATE_TOKEN": "do-not-record-cloud-token",
+    }.items():
+        monkeypatch.setenv(name, value)
+    report = cloud_worker.run_cloud_experiment(config, tmp_path, "flowstate-test")
+    assert report["cloud_run"] == context
+    assert report["build_commit"] == "abcdef0123" * 4
+    serialized = json.dumps({"report": report, "record": published[0][-1]})
+    assert "do-not-record" not in serialized
+    assert "GOOGLE_APPLICATION_CREDENTIALS" not in serialized
+
