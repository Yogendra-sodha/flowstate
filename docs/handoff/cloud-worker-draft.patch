diff --git a/src/flowstate/cloud_worker.py b/src/flowstate/cloud_worker.py
new file mode 100644
index 0000000..290cbde
--- /dev/null
+++ b/src/flowstate/cloud_worker.py
@@ -0,0 +1,97 @@
+"""One bounded numerical experiment followed by a verified GCS publication.
+
+The local lake may be ephemeral. A successful worker exit requires a committed
+remote manifest; a recorded numerical failure is published too. This worker
+does not claim distributed deduplication or recovery after container loss.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+
+from flowstate import gcs_store
+from flowstate.artifact_mirror import _prefix
+from flowstate.engine import run_experiment
+from flowstate.numerics import normalize_config
+
+MAX_GRID_SIZE = 128
+MAX_DARCY_GRID_SIZE = 65
+MAX_STEPS = 10_000
+_CLOUD_RUN_CONTEXT = (
+    "CLOUD_RUN_JOB",
+    "CLOUD_RUN_EXECUTION",
+    "CLOUD_RUN_TASK_INDEX",
+    "CLOUD_RUN_TASK_ATTEMPT",
+)
+
+
+def run_cloud_experiment(
+    config: dict,
+    lake_root: str | Path,
+    bucket: str,
+    *,
+    prefix: str = "",
+    project: str | None = None,
+) -> dict:
+    """Run once and publish evidence, returning only after remote commit.
+
+    Invalid configuration/runtime settings raise ValueError before numerical
+    work or authentication. Numerical failures return ``status='failed'`` after
+    publication. Transfer failures raise RuntimeError even when computation
+    completed successfully; the local result remains available for diagnosis.
+    Runtime context is included only in this report, never read wholesale from
+    the environment or added to immutable scientific artifacts.
+    """
+    canonical = normalize_config(config)
+    max_grid = MAX_DARCY_GRID_SIZE if canonical["equation"] == "darcy2d" else MAX_GRID_SIZE
+    if canonical["grid_size"] > max_grid:
+        raise ValueError(f"Cloud worker grid_size must be <= {max_grid}")
+    if canonical.get("steps", 0) > MAX_STEPS:
+        raise ValueError(f"Cloud worker steps must be <= {MAX_STEPS}")
+    if os.environ.get("CLOUD_RUN_TASK_COUNT", "1") != "1":
+        raise ValueError("Cloud worker requires CLOUD_RUN_TASK_COUNT=1")
+    if os.environ.get("CLOUD_RUN_TASK_INDEX", "0") != "0":
+        raise ValueError("Cloud worker requires CLOUD_RUN_TASK_INDEX=0")
+    build_commit = os.environ.get("FLOWSTATE_BUILD_COMMIT")
+    if build_commit is not None and re.fullmatch(r"[0-9a-f]{40}", build_commit) is None:
+        raise ValueError("FLOWSTATE_BUILD_COMMIT must be exactly 40 lowercase hexadecimal digits")
+    if (
+        not isinstance(bucket, str)
+        or not bucket
+        or bucket != bucket.strip()
+        or any(character in bucket for character in ("/", "\\", ":"))
+    ):
+        raise ValueError("Cloud worker bucket must be a bucket name without gs://")
+    if not isinstance(prefix, str):
+        raise ValueError("Cloud worker prefix must be a string")
+    prefix = _prefix(prefix)
+    context = {key: os.environ[key] for key in _CLOUD_RUN_CONTEXT if key in os.environ}
+
+    outcome = run_experiment(canonical, lake_root, stream=True)
+    record = outcome.record
+    if record["status"] not in {"completed", "failed"}:
+        raise RuntimeError("Cloud worker experiment did not produce a finalized result")
+    try:
+        uploaded = gcs_store.upload_experiment(
+            lake_root, record["id"], bucket, prefix=prefix, project=project
+        )
+    except Exception as exc:
+        # Publication is an infrastructure boundary. SDK authentication, retry,
+        # transport and integrity failures all prevent a successful worker exit.
+        raise RuntimeError(f"GCS upload failed for experiment {record['id']}: {exc}") from exc
+    if uploaded.get("committed") is not True:
+        raise RuntimeError(f"GCS upload did not commit experiment {record['id']}")
+    report = {
+        "experiment_id": record["id"],
+        "status": record["status"],
+        "metrics": record["metrics"],
+        "error": record["error"],
+        "upload": uploaded,
+        "local_resumed": outcome.resumed,
+        "cloud_run": context,
+    }
+    if build_commit is not None:
+        report["build_commit"] = build_commit
+    return report
diff --git a/tests/test_cloud_worker.py b/tests/test_cloud_worker.py
new file mode 100644
index 0000000..b6adb2a
--- /dev/null
+++ b/tests/test_cloud_worker.py
@@ -0,0 +1,247 @@
+"""Bounded cloud-worker execution and exit contracts without live GCS requests."""
+
+import json
+from unittest.mock import Mock
+
+import pytest
+
+from flowstate import cloud_worker, gcs_store
+from flowstate.cli import main
+from flowstate.engine import RunOutcome
+from flowstate.lake import Lake
+
+
+@pytest.fixture(autouse=True)
+def local_runtime(monkeypatch):
+    for name in (
+        "CLOUD_RUN_JOB",
+        "CLOUD_RUN_EXECUTION",
+        "CLOUD_RUN_TASK_COUNT",
+        "CLOUD_RUN_TASK_INDEX",
+        "CLOUD_RUN_TASK_ATTEMPT",
+        "FLOWSTATE_BUILD_COMMIT",
+    ):
+        monkeypatch.delenv(name, raising=False)
+
+
+@pytest.fixture
+def config():
+    return {"equation": "burgers1d", "grid_size": 8, "steps": 2, "save_every": 1}
+
+
+@pytest.fixture
+def published(monkeypatch):
+    calls = []
+
+    def upload(lake_root, experiment_id, bucket, prefix="", project=None):
+        lake = Lake(lake_root)
+        # Upload must only receive a finalized, verifiable result.
+        assert not lake.verify(experiment_id)
+        record = lake.load_record(experiment_id)
+        assert record["status"] in {"completed", "failed"}
+        calls.append((lake_root, experiment_id, bucket, prefix, project, record))
+        return {"id": experiment_id, "committed": True, "bucket": bucket, "prefix": prefix}
+
+    monkeypatch.setattr(gcs_store, "upload_experiment", upload)
+    return calls
+
+
+@pytest.mark.parametrize("equation", ["burgers1d", "navier_stokes2d", "darcy2d"])
+def test_worker_runs_one_verified_experiment_and_publishes_it(tmp_path, equation, published):
+    config = {"equation": equation, "grid_size": 8}
+    if equation != "darcy2d":
+        config.update(steps=2, save_every=1)
+    report = cloud_worker.run_cloud_experiment(
+        config, tmp_path, "flowstate-test", prefix="flowstate/", project="test-project"
+    )
+    assert report["status"] == "completed" and report["error"] is None
+    assert report["upload"]["committed"] is True
+    assert report["local_resumed"] is False
+    assert len(published) == 1
+    root, experiment_id, bucket, prefix, project, record = published[0]
+    assert root == tmp_path and experiment_id == report["experiment_id"]
+    assert (bucket, prefix.rstrip("/"), project) == ("flowstate-test", "flowstate", "test-project")
+    assert record["equation"] == equation and record["metrics"] == report["metrics"]
+    assert record["storage_mode"] == ("buffered" if equation == "darcy2d" else "streamed")
+    assert len(Lake(tmp_path).records()) == 1
+
+
+def test_numerical_failure_is_published_as_failure_evidence(tmp_path, config, published):
+    report = cloud_worker.run_cloud_experiment({**config, "dt": 100}, tmp_path, "flowstate-test")
+    assert report["status"] == "failed"
+    assert "stability" in report["error"]["message"].lower()
+    assert report["upload"]["committed"] is True and len(published) == 1
+    assert published[0][-1]["status"] == "failed"
+    assert not (tmp_path / "experiments" / report["experiment_id"] / "fields.zarr").exists()
+
+
+def test_local_resume_still_retries_cloud_publication(tmp_path, config, published, monkeypatch):
+    from flowstate import engine
+
+    provenance = engine.capture_provenance()
+    monkeypatch.setattr(engine, "capture_provenance", lambda: provenance)
+    first = cloud_worker.run_cloud_experiment(config, tmp_path, "flowstate-test")
+    second = cloud_worker.run_cloud_experiment(config, tmp_path, "flowstate-test")
+    assert first["experiment_id"] == second["experiment_id"]
+    assert first["local_resumed"] is False and second["local_resumed"] is True
+    assert len(published) == 2 and len(Lake(tmp_path).records()) == 1
+
+
+@pytest.mark.parametrize("failure", [OSError("upload unavailable"), RuntimeError("upload denied")])
+def test_upload_failure_keeps_local_evidence_and_cannot_return_success(
+    tmp_path, config, monkeypatch, failure
+):
+    monkeypatch.setattr(gcs_store, "upload_experiment", Mock(side_effect=failure))
+    with pytest.raises((OSError, RuntimeError), match="upload"):
+        cloud_worker.run_cloud_experiment(config, tmp_path, "flowstate-test")
+    records = Lake(tmp_path).records()
+    assert len(records) == 1 and records[0]["status"] == "completed"
+    assert not Lake(tmp_path).verify(records[0]["id"])
+
+
+def test_uncommitted_upload_is_not_reported_as_success(tmp_path, config, monkeypatch):
+    monkeypatch.setattr(gcs_store, "upload_experiment", lambda *a, **kw: {"committed": False})
+    with pytest.raises(RuntimeError):
+        cloud_worker.run_cloud_experiment(config, tmp_path, "flowstate-test")
+
+
+@pytest.mark.parametrize(
+    "config",
+    [
+        {"equation": "burgers1d", "grid_size": 129, "steps": 1},
+        {"equation": "navier_stokes2d", "grid_size": 129, "steps": 1},
+        {"equation": "darcy2d", "grid_size": 66},
+        {"grid_size": 8, "steps": 10001, "save_every": 10001},
+        {"grid_size": True},
+        {"equation": "unknown"},
+    ],
+)
+def test_invalid_work_is_rejected_before_computation_or_cloud_use(tmp_path, config, monkeypatch):
+    compute, upload = Mock(), Mock()
+    monkeypatch.setattr(cloud_worker, "run_experiment", compute)
+    monkeypatch.setattr(gcs_store, "upload_experiment", upload)
+    lake = tmp_path / "unused"
