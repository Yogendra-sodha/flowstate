+@pytest.mark.parametrize("dt,exit_code,status", [(0.001, 0, "completed"), (100, 1, "failed")])
+def test_cli_runs_and_publishes_then_returns_numerical_status(
+    tmp_path, config, published, capsys, dt, exit_code, status
+):
+    path = tmp_path / "config.json"
+    path.write_text(json.dumps({**config, "dt": dt}), encoding="utf-8")
+    assert main(
+        [
+            "--lake", str(tmp_path / "lake"), "cloud-worker", str(path), "flowstate-test",
+            "--prefix", "flowstate/", "--project", "test-project",
+        ]
+    ) == exit_code
+    output = capsys.readouterr()
+    report = json.loads(output.out)
+    assert report["status"] == status and report["upload"]["committed"] is True
+    assert output.err == ""
+    assert published[0][2:5] == ("flowstate-test", "flowstate/", "test-project")
+
