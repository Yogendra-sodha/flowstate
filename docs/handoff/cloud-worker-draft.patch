+FROM python:3.12-slim-bookworm AS build
+COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/
+WORKDIR /app
+ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
+COPY pyproject.toml uv.lock README.md LICENSE ./
+COPY src/ ./src/
+RUN uv sync --locked --no-dev --extra gcs --no-editable
+
+FROM python:3.12-slim-bookworm
+ARG FLOWSTATE_BUILD_COMMIT
+RUN python -c "import os,re; assert re.fullmatch('[0-9a-f]{40}', os.environ.get('FLOWSTATE_BUILD_COMMIT', '')), 'A full source commit is required'"
+ENV FLOWSTATE_BUILD_COMMIT=${FLOWSTATE_BUILD_COMMIT} \
+    PATH=/app/.venv/bin:$PATH \
+    PYTHONUNBUFFERED=1 \
+    PYTHONDONTWRITEBYTECODE=1 \
+    OMP_NUM_THREADS=1 \
+    OPENBLAS_NUM_THREADS=1
+LABEL org.opencontainers.image.revision=${FLOWSTATE_BUILD_COMMIT}
+WORKDIR /app
+COPY --from=build /app/.venv /app/.venv
+COPY examples/burgers.json examples/navier_stokes.json examples/darcy.json ./examples/
+USER 65532:65532
+ENTRYPOINT ["flowstate"]
